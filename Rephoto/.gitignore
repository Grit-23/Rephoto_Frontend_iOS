# Tuist가 매니페스트로 만드는 파일 — 커밋하지 않는다
*.xcodeproj
*.xcworkspace
Derived/
graph.dot

# Tuist가 내려받는 SPM 의존성 (Package.resolved는 커밋한다)
Tuist/.build/

# 로컬 비밀 값 — 루트 .gitignore의 *.xcconfig 규칙에서 Shared.xcconfig만 다시 포함한다
!Config/Shared.xcconfig
Config/Secrets.xcconfig

# mockolo 생성물 (make generate가 먼저 만든다)
Projects/**/Testing/Generated/
